rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Service and public content images remain readable by the storefront.
    // All new uploads are routed through the authenticated server endpoint.
    match /services/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /posts/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Read behavior is retained for current receipt and KYC screens.
    // Server-side upload authorization is enforced by /api/upload.
    match /receipts/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    match /kyc/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Unknown storage paths are denied rather than inheriting public access.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
