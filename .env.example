# Local server environment only. Copy this file to .env.local.
# .env.local is ignored by Git and must never be committed.

# Required only for the server-side Gemini chat endpoint.
GEMINI_API_KEY=

# Firebase Admin server credential.
# Use a one-line JSON value with escaped newlines in private_key, or use
# Application Default Credentials on supported Google Cloud environments.
# Never paste this credential into source files or commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional: server key for Firebase Cloud Messaging notifications.
FCM_SERVER_KEY=
