rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- DEFAULT DENY ALL ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- GLOBAL HELPERS ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && (
        (request.auth.token.email != null && request.auth.token.email.lower() == 'khyhajmr08@gmail.com') || 
        request.auth.uid == 'PqXqqCgdC1eYPz4HKHHLtDRejPD3'
      );
    }

    function isStaffMember() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.active == true
      );
    }

    function hasStaffRole(role) {
      return isOwner() || (
        isStaffMember() && 
        get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == role
      );
    }

    function isAdmin() {
      return isOwner() || isStaffMember() || isUserRole('admin');
    }

    function isUserRole(role) {
       return isSignedIn() && 
              exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
              (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role ||
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.staffRole == role);
    }

    // --- SERVICES ---
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isOwner() || hasStaffRole('services_manager') || isUserRole('admin');
    }

    // --- USERS ---
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      // A normal account may create only its own unprivileged default profile.
      // The project owner is resolved independently by UID/email and may keep the owner profile role.
      allow create: if isOwner() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        request.resource.data.role == 'user' &&
        request.resource.data.blocked == false &&
        (!('reviewStatus' in request.resource.data) || request.resource.data.reviewStatus == 'Not Verified') &&
        (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false) &&
        (!('referralsCount' in request.resource.data) || request.resource.data.referralsCount == 0) &&
        (!('referralEarnings' in request.resource.data) || request.resource.data.referralEarnings == 0) &&
        (!('loyaltyPoints' in request.resource.data) || request.resource.data.loyaltyPoints == 0) &&
        (!('isReferralRewarded' in request.resource.data) || request.resource.data.isReferralRewarded == false) &&
        (!('referredBy' in request.resource.data) ||
          request.resource.data.referredBy == null ||
          (request.resource.data.referredBy is string &&
           request.resource.data.referredBy != request.auth.uid &&
           exists(/databases/$(database)/documents/users/$(request.resource.data.referredBy)))) &&
        !('staffRole' in request.resource.data) &&
        !('balance' in request.resource.data)
      );

      // Users may edit ordinary profile details only; privilege, verification and money fields are server/admin controlled.
      allow update: if isOwner() || (
        isSignedIn() &&
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role', 'staffRole', 'blocked', 'isVerified',
          'referralsCount', 'referralEarnings', 'isReferralRewarded',
          'firstCompletedOrderAt', 'balance', 'loyaltyPoints', 'referredBy',
          'phoneStatus', 'phoneRejectReason', 'reviewedBy', 'reviewedByName',
          'reviewedAt', 'verifiedAt', 'blockReason'
        ]) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['reviewStatus']) ||
          request.resource.data.reviewStatus == 'Under Review') &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['kyc_completed']) ||
          request.resource.data.kyc_completed == false)
      );
      allow delete: if isOwner();
    }

    // --- STAFF MEMBERS & ROLES (RBAC) ---
    match /staff/{staffId} {
      // Owner can read all, staff members can read their own assignment
      allow read: if isOwner() || (isSignedIn() && request.auth.uid == staffId);
      // ONLY the Owner can hire, fire, or modify staff roles
      allow write: if isOwner();
    }

    // --- AUDIT LOGS (IMMUTABLE SECURITY TRAIL) ---
    match /audit_logs/{logId} {
      // Owner can read full audit logs
      allow read: if isOwner();
      // Staff members and owner can log audit records
      allow create: if isSignedIn();
      // Audit logs can NEVER be updated or deleted by anyone
      allow update, delete: if false;
    }

    // --- ORDERS ---
    match /orders/{orderId} {
      // Orders are readable only by their authenticated owner or authorized staff.
      // Guest orders are served through the server endpoint after verification of the private tracking token.
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      // All new orders must pass through the trusted server endpoint. The Admin SDK bypasses rules.
      // This prevents client-side price tampering and bypassing atomic idempotency checks.
      allow create: if false;

      // Orders managers and owner can update status/notes
      allow update: if isOwner() || hasStaffRole('orders_manager') || isUserRole('orders_manager') || isUserRole('admin');
      // ONLY the Owner can permanently delete order history
      allow delete: if isOwner();
    }

    // --- ORDER IDEMPOTENCY ---
    // Idempotency records contain server-only hashes and tracking credentials.
    match /order_idempotency/{attemptId} {
      allow read, write: if false;
    }

    // --- NOTIFICATIONS ---
    match /notifications/{notifId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() && 
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
      );
      allow delete: if isOwner() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // --- WITHDRAWALS ---
    match /withdrawals/{withdrawalId} {
      allow read: if isOwner() || hasStaffRole('finance') || hasStaffRole('finance_manager') || isUserRole('admin') ||
                    (isSignedIn() && resource.data.userId == request.auth.uid);
      // Creation, point reservation, approval and refunds are performed by trusted server transactions only.
      allow create, update, delete: if false;
    }

    // --- KYC REQUESTS ---
    match /kyc_requests/{userId} {
      allow read: if isOwner() || hasStaffRole('orders_manager') || isUserRole('admin') || (isSignedIn() && request.auth.uid == userId);
      // Users can submit their document but cannot approve or set verification status
      allow create: if (isSignedIn() && request.auth.uid == userId) &&
                       (!('isVerified' in request.resource.data) || request.resource.data.isVerified == false) &&
                       (!('reviewStatus' in request.resource.data) || request.resource.data.reviewStatus == 'pending');
      // Only authorized staff can change verification status; users can only re-upload their documents while pending
      allow update: if isOwner() || hasStaffRole('orders_manager') || isUserRole('admin') || (
        isSignedIn() && 
        request.auth.uid == userId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isVerified', 'reviewStatus', 'reviewedBy', 'reviewedByName', 'reviewedAt', 'adminNote'])
      );
      allow delete: if isOwner();
    }

    // --- SETTINGS (GLOBAL & PAYMENT) ---
    match /settings/{docId} {
      allow read: if true;
      // Sensitive payment and system settings can only be altered by Owner or Admin
      allow write: if isOwner() || isUserRole('admin');
    }

    // --- POSTS / WHATSAPP OFFERS ---
    match /posts/{postId} {
      allow read: if true;
      allow write: if isOwner() || hasStaffRole('services_manager') || isUserRole('admin');
    }

    // --- ACTIVE VISITORS ---
    match /active_visitors/{sessionId} {
      allow read: if isAdmin();
      allow write: if true;
    }

  }
}
